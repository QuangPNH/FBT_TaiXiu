<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.GameActivity">

    <TextView
        android:id="@+id/tvMoney"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số tiền còn lại: 1000$"
        android:textSize="20sp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/etBetAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Nhập số tiền cược"
        android:inputType="number"
        android:layout_below="@id/tvMoney"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:width="200dp"/>

    <TextView
        android:id="@+id/tvTaiBetAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:layout_below="@id/etBetAmount"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnTai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đặt cửa Tài"
        android:layout_below="@+id/tvTaiBetAmount"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"
        android:layout_marginStart="50dp"/>

    <TextView
        android:id="@+id/tvXiuBetAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:layout_below="@id/etBetAmount"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnXiu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đặt cửa Xỉu"
        android:layout_below="@+id/tvXiuBetAmount"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="50dp"/>

    <Button
        android:id="@+id/btnCancelBet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hủy cược"
        android:layout_below="@id/btnTai"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvDice1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/btnCancelBet"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvDice2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tvDice1"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvDice3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tvDice2"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tvDice3"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tvResult"
        android:layout_marginTop="20dp"/>
</RelativeLayout>